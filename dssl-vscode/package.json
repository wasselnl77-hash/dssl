{
  "name": "dssl-vscode",
  "displayName": "DSSL Language Support",
  "description": "The DSSL style language in your editor: syntax highlighting, real-compiler diagnostics (the same errors the browser console shows), completions from the live token registry and for textures, auras and sliders, hover docs, an interactive designer with sliders and live previews for aura, texture and range sliders, and a CSS to DSSL converter. Works in VS Code and VSCodium.",
  "version": "0.9.0",
  "publisher": "ehs-studio",
  "icon": "icon.png",
  "license": "MIT",
  "engines": {
    "vscode": "^1.82.0"
  },
  "categories": [
    "Programming Languages",
    "Linters"
  ],
  "keywords": [
    "aura",
    "css",
    "css converter",
    "design tokens",
    "designer",
    "dssl",
    "particles",
    "style language",
    "styling",
    "texture"
  ],
  "activationEvents": [
    "onLanguage:dssl",
    "onCommand:dssl.openDesigner",
    "onCommand:dssl.openAuraDesigner",
    "onCommand:dssl.openTextureDesigner",
    "onCommand:dssl.openSliderDesigner",
    "onCommand:dssl.convertCss"
  ],
  "main": "./extension.js",
  "contributes": {
    "languages": [
      {
        "id": "dssl",
        "aliases": [
          "DSSL",
          "dssl"
        ],
        "extensions": [
          ".dssl"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "dssl",
        "scopeName": "source.dssl",
        "path": "./syntaxes/dssl.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "DSSL",
      "properties": {
        "dssl.diagnostics.enable": {
          "type": "boolean",
          "default": true,
          "description": "Run the real DSSL compiler on save and change, and surface errors and warnings as diagnostics."
        },
        "dssl.diagnostics.debounce": {
          "type": "number",
          "default": 250,
          "description": "Milliseconds to wait after a keystroke before re-running the compiler."
        }
      }
    },
    "commands": [
      {
        "command": "dssl.openDesigner",
        "title": "Open the designer",
        "category": "DSSL",
        "icon": "$(paintcan)"
      },
      {
        "command": "dssl.openAuraDesigner",
        "title": "Design an aura (glow and particles)",
        "category": "DSSL"
      },
      {
        "command": "dssl.openTextureDesigner",
        "title": "Design a texture",
        "category": "DSSL"
      },
      {
        "command": "dssl.openSliderDesigner",
        "title": "Design a range slider",
        "category": "DSSL"
      },
      {
        "command": "dssl.convertCss",
        "title": "Convert a CSS file to DSSL",
        "category": "DSSL"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "dssl.openDesigner",
          "when": "resourceLangId == dssl",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "dssl.openDesigner",
          "when": "resourceLangId == dssl",
          "group": "navigation@9"
        }
      ],
      "explorer/context": [
        {
          "command": "dssl.convertCss",
          "when": "resourceExtname == .css",
          "group": "navigation@9"
        }
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "https://huggingface.co/EHS-Studio/dssl"
  }
}
